{
  "name": "Heroku HTTP Proxy",
  "description": "Simple authenticated HTTP proxy server for bypassing network restrictions (Basic Auth protected)",
  "repository": "https://github.com/IT25101377/Proxy",
  "logo": "https://cdn-icons-png.flaticon.com/512/5968/5968890.png",
  "keywords": ["proxy", "http-proxy", "bypass", "nodejs"],
  "stack": "heroku-22",
  "env": {
    "PROXY_USERNAME": {
      "description": "Proxy username (default: sliit)",
      "value": "sliit",
      "required": true
    },
    "PROXY_PASSWORD": {
      "description": "Proxy password (default: sliit)",
      "value": "sliit",
      "required": true
    }
  },
  "formation": {
    "web": {
      "quantity": 1
    }
  },
  "addons": [],
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ]
}
